{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "histogram_quantile(0.95, rate(docgen_parse_duration_seconds_bucket[5m]))", "refId": "A" }],
      "title": "Parse duration p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "avg(docgen_coverage_percent)", "refId": "A" }],
      "title": "Documentation coverage",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [{ "expr": "sum by (format) (rate(docgen_export_duration_seconds_count[5m]))", "refId": "A" }],
      "title": "Exports per format",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [{ "expr": "rate(http_requests_total[1m])", "refId": "A" }],
      "title": "HTTP requests per second",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["docgen"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "DocGen Dashboard",
  "uid": "docgen",
  "version": 1
}

